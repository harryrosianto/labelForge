# Konfigurasi perekam dataset (lfcapture). Salin ke capture.env lalu: chmod 600 capture.env
# File ini berisi password akun SysGuard; jangan di-commit.

# --- SysGuard Vision di perangkat yang sama ---
SG_URL=https://127.0.0.1:8080
# Akun gateway khusus perekam, role viewer, tanpa TOTP.
SG_USERNAME=dataset
SG_PASSWORD=ganti-dengan-password-akun
# Atau simpan password di file terpisah (lebih aman dari tercetak tidak sengaja):
# SG_PASSWORD_FILE=/home/sysedge/lfcapture/password
# Untuk SG_URL selain loopback: isi sertifikat SysGuard, atau SG_INSECURE_TLS=1 bila disengaja.
# SG_CA_FILE=/home/sysedge/lfcapture/sysguard-cert.pem

# --- Output ---
CAPTURE_DIR=/home/sysedge/dataset
# Nama folder harian: <prefix>-YYYYMMDD
CAPTURE_PREFIX=ppe
# Kosong = semua kamera yang aktif di SysGuard; atau daftar id dipisah koma.
CAPTURE_CAMERAS=
# Urutan class = index YOLO. Harus sama dengan nama class model PPE SysGuard (ppe5 di bawah).
CAPTURE_CLASSES=person,Helmet,Mask,Safety Vest,boots,glove
# Class untuk box orang dari tracker; kosongkan bila box orang tidak perlu disimpan.
CAPTURE_PERSON_CLASS=person

# --- Aturan pemilihan frame per kamera ---
CAPTURE_INTERVAL_S=10
CAPTURE_UNCERTAIN_LOW=0.25
CAPTURE_UNCERTAIN_HIGH=0.6
CAPTURE_UNCERTAIN_COOLDOWN_S=3
CAPTURE_VIOLATION_COOLDOWN_S=5
CAPTURE_EMPTY_INTERVAL_S=300
CAPTURE_MIN_GAP_S=1
CAPTURE_DEDUP_IOU=0.85
CAPTURE_MAX_PER_HOUR=360
# Frame dilewati bila snapshot tiba lebih dari N detik setelah deteksinya.
CAPTURE_MAX_SNAPSHOT_LAG_S=1.0

# --- Penjaga disk ---
CAPTURE_DISK_MAX_USED_PCT=85
CAPTURE_DISK_MIN_FREE_MB=1024
CAPTURE_STATS_INTERVAL_S=60
