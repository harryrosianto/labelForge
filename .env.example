# Salin ke .env lalu sesuaikan.

# --- Core ---
DATABASE_URL=sqlite:///./data/labelforge.db
DATA_DIR=./data
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173"]

# --- Inference ---
# Provider default untuk job baru & CLI: owlv2 | grounding_dino | remote
DEFAULT_PROVIDER=owlv2
DEFAULT_MODE=text
# auto = CUDA jika tersedia, selain itu CPU
DEVICE=auto
# fp16 hanya berlaku di GPU
USE_FP16=false
# Ganti ke IDEA-Research/grounding-dino-tiny untuk CPU yang lebih cepat (akurasi lebih rendah)
GDINO_MODEL_ID=IDEA-Research/grounding-dino-base
GDINO_BOX_THRESHOLD=0.35
GDINO_TEXT_THRESHOLD=0.25
OWLV2_MODEL_ID=google/owlv2-base-patch16-ensemble
OWLV2_SCORE_THRESHOLD=0.2
OWLV2_IMAGE_SCORE_THRESHOLD=0.65
OWLV2_NMS_THRESHOLD=0.3
NMS_IOU_THRESHOLD=0.5
# Lokasi cache model HuggingFace (di Docker di-mount sebagai volume)
# HF_HOME=./data/hf_cache

# --- Remote inference server (RemoteApiProvider) ---
# REMOTE_INFERENCE_URL=http://gpu-server:8100
# REMOTE_INFERENCE_TOKEN=
REMOTE_INFERENCE_TIMEOUT=120

# Token yang diwajibkan jika proses ini dijalankan sebagai inference server
# INFERENCE_SERVER_TOKEN=

# --- Keamanan ---
# Kunci enkripsi URL kamera RTSP (wajib sebelum menambah kamera). Buat dengan:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Jangan diganti setelah kamera ditambahkan; URL lama tidak bisa dibuka lagi.
# SECRET_KEY=

# --- Upload ---
THUMBNAIL_SIZE=320
MAX_UPLOAD_MB=2048
